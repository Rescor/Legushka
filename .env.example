# Токен для Буси. Взять можно у https://t.me/BotFather
BOT_TOKEN=your-bot-token-from-botfather

# Твой Telegram ID, который Буся сделает другом при
# каждом запуске и защитит от разжалования/бана через "Буся, бан" -
# нужно, чтобы было кому вообще выдавать доверие через "Буся, дружи".
# Свой Telegram ID можно узнать, написав боту https://t.me/userinfobot
INITIAL_FRIEND_ID=

# Контакт человека, кого нужно просить добавить чат в
# доверенные (@username или просто текст).
# Список доверенных чатов хранится в БД. Пока он пуст - Буся НЕ
# доверяет НИ ОДНОМУ чату - "ква"/"квакни"/"дай жабу"/передразнивание
# будут работать, а на остальные "<имя>, ..."-команды Буся откажет и
# попросят написать OWNER_CONTACT. Чтобы Буся заработала полноценно:
# задай INITIAL_FRIEND_ID выше, добавь Бусю в нужный чат и напиши там
# "Буся, доверяй <id>" или же просто "Буся, доверяй"
# (без id - доверяет текущему чату).
OWNER_CONTACT=моему владельцу @username

# Уровень логов: DEBUG/INFO/WARNING/ERROR. INFO (по умолчанию) печатает
# в т.ч. служебную строку aiogram на каждое обработанное сообщение -
# поставь WARNING, если это шумно.
LOG_LEVEL=INFO

# Короткое имя стикерпака (из ссылки t.me/addstickers/<имя>), стикером из
# которого Буся отвечает на "дай жабу".
# Если хочешь отправлять свой стикер - замени.
STICKER_SET_NAME=Busyastickerset

# Имена через запятую, на которые бот откликается в командах вида
# "<имя>, кто я". Чтобы добавить новое имя - допиши его через запятую.
NAME_ALIASES=буся,легушька

# Предупреждение "ВНИМАНИЕ! Вот это сообщение было отредактировано только
# что" на редактирование старого сообщения. Выключено по умолчанию:
# Telegram шлёт edited_message не только на настоящие правки текста, но и
# на реакции на сообщения - отличить одно от другого по самому апдейту
# нельзя, так что Буся спамит ложными срабатываниями. Включать осознанно.
EDIT_WARNING_ENABLED=false
